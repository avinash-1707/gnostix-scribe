# Database (Neon Postgres — asyncpg URL with ssl=require)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<neon-host>/<db>?ssl=require

# JWT
SECRET_KEY=replace-with-32-byte-hex
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini (LLM + Imagen 3.0 via langchain-google-genai)
GOOGLE_API_KEY=your-gemini-key

# Cloudinary (single-URL form)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# CORS
CLIENT_URL=http://localhost:3000
