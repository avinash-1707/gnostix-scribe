# Database (Neon Postgres — asyncpg URL with ssl=require)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<neon-host>/<db>?ssl=require

# JWT
SECRET_KEY=replace-with-32-byte-hex
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini (LLM fallback when OPENROUTER_API_KEY unset; image generation)
GOOGLE_API_KEY=your-gemini-key

# OpenRouter (primary text-LLM gateway; per-tier model overrides optional —
# defaults live in server/agent/llm.py)
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL_BUDGET=
# OPENROUTER_MODEL_WRITER=
# OPENROUTER_MODEL_JUDGE=

# OpenAI (image generation via gpt-image-1)
OPENAI_API_KEY=sk-...

# Cloudinary (single-URL form)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# CORS
CLIENT_URL=http://localhost:3001
